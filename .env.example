POSTGRES_DB=nazarovgroup
POSTGRES_USER=nazarovgroup
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://nazarovgroup:change_me@postgres:5432/nazarovgroup

ENVIRONMENT=development
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost
HTTP_PORT=80

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
BOT_INTERNAL_SECRET=change_me_with_a_random_64_character_value
LOG_LEVEL=INFO

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

JWT_SECRET=change_me_in_environment

# Admin access. In production leave ADMIN_PASSWORD empty and set a PBKDF2 hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=false
BUSINESS_TIMEZONE=Asia/Yekaterinburg
BOOKING_OPEN_TIME=09:00
BOOKING_CLOSE_TIME=20:00
